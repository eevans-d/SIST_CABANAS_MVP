# ============================================================================
# 🏠 Sistema MVP de Automatización de Reservas - Environment Variables
# ============================================================================
#
# Este archivo contiene TODAS las variables de entorno necesarias para el
# funcionamiento del sistema. Copia este archivo a .env y ajusta los valores.
#
# ⚠️  IMPORTANTE: Nunca commits archivos .env con valores reales a git
#
# 📋 Variables marcadas con [REQUIRED] son obligatorias para funcionamiento
# 📋 Variables marcadas con [OPTIONAL] tienen valores por defecto
# 📋 Variables marcadas with [PRODUCTION] son críticas para deploy en prod
#

# ============================================================================
# 🌍 ENVIRONMENT CONFIGURATION
# ============================================================================

# Entorno de ejecución [REQUIRED]
# Valores: development, staging, production
# En producción cambia comportamiento de logs, validaciones, etc.
ENVIRONMENT=development

# ============================================================================
# 🗄️ DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================

# URL de conexión a PostgreSQL [REQUIRED]
# Formato: postgresql+asyncpg://usuario:contraseña@host:puerto/nombre_db
# IMPORTANTE: Debe usar PostgreSQL 16+ con extensión btree_gist para constraints
# Para generar contraseña segura: openssl rand -base64 32
DATABASE_URL=postgresql+asyncpg://alojamientos:YOUR_SECURE_DB_PASSWORD_HERE@db:5432/alojamientos_db

# Pool de conexiones [OPTIONAL]
# Tamaño del pool de conexiones a la DB
DB_POOL_SIZE=20

# Overflow máximo del pool [OPTIONAL]
# Conexiones adicionales cuando pool está lleno
DB_MAX_OVERFLOW=0

# Variables de Docker Compose (compatibilidad)
DB_NAME=alojamientos_db
DB_USER=alojamientos
# Contraseña DB (match con DATABASE_URL) - Generar con: openssl rand -base64 32
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE
POSTGRES_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE

# ============================================================================
# 🔴 REDIS CONFIGURATION
# ============================================================================

# URL de conexión a Redis [REQUIRED]
# Usado para: locks de doble-booking, cache, rate limiting, jobs background
# Formato: redis://host:puerto/db_number
# Para generar contraseña segura: openssl rand -base64 32
REDIS_URL=redis://:YOUR_SECURE_REDIS_PASSWORD_HERE@redis:6379/0

# Contraseña de Redis [OPTIONAL]
# Si Redis tiene AUTH habilitado - Generar con: openssl rand -base64 32
REDIS_PASSWORD=YOUR_SECURE_REDIS_PASSWORD_HERE

# ============================================================================
# 💬 WHATSAPP BUSINESS CLOUD API [PRODUCTION]
# ============================================================================

# Token de acceso a WhatsApp Business [REQUIRED]
# Obtenido desde Meta for Developers > WhatsApp > Getting Started
# Ejemplo: EAABxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

# Token de verificación de webhook [OPTIONAL]
# Se genera automáticamente si no se especifica
# Debe coincidir con el configurado en Meta for Developers
# Para generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_VERIFY_TOKEN=YOUR_WHATSAPP_VERIFY_TOKEN_HERE

# Secreto de aplicación de WhatsApp [REQUIRED]
# Para validar firma de webhooks (seguridad crítica)
# Obtenido desde Meta for Developers > WhatsApp > App Secret
WHATSAPP_APP_SECRET=your_whatsapp_app_secret_here

# ID del teléfono de WhatsApp Business [REQUIRED]
# Número de teléfono desde donde se envían mensajes
# Formato: 15551234567 (sin + ni espacios)
WHATSAPP_PHONE_ID=your_whatsapp_phone_id_here

# ============================================================================
# 💳 MERCADO PAGO INTEGRATION [PRODUCTION]
# ============================================================================

# Token de acceso de Mercado Pago [REQUIRED]
# Para crear payment links y procesar pagos
# Obtenido desde: Mercado Pago > Developers > Credenciales
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token_here

# Secreto de webhook de Mercado Pago [PRODUCTION]
# Para validar firmas de webhooks de pagos (seguridad crítica)
# Configurado en: Mercado Pago > Developers > Webhooks
MERCADOPAGO_WEBHOOK_SECRET=optional_webhook_secret

# ============================================================================
# 🔐 SECURITY & AUTHENTICATION
# ============================================================================

# Secreto para JWT tokens [OPTIONAL]
# Se genera automáticamente si no se especifica
# Para autenticación de dashboard admin
# Para generar: openssl rand -base64 32
JWT_SECRET=YOUR_SECURE_JWT_SECRET_HERE

# Algoritmo JWT [OPTIONAL]
JWT_ALGORITHM=HS256

# Expiración de tokens JWT en horas [OPTIONAL]
JWT_EXPIRATION_HOURS=24

# Sal para generación de tokens iCal [OPTIONAL]
# Se genera automáticamente si no se especifica
# Para generar: openssl rand -hex 16
ICS_SALT=YOUR_SECURE_ICS_SALT_HERE

# ============================================================================
# 🌐 APPLICATION URLS
# ============================================================================

# URL base de la aplicación [REQUIRED]
# Usado para: links en emails, webhooks callbacks, iCal URLs
# Ejemplos: https://your-domain.com, http://localhost:8000
BASE_URL=https://your-domain.com

# Dominio principal [OPTIONAL]
# Usado para configuración de cookies y CORS
DOMAIN=your-domain.com

# Orígenes permitidos para CORS [OPTIONAL]
# Lista separada por comas de dominios permitidos para frontend
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# ============================================================================
# 📧 EMAIL CONFIGURATION (SMTP) [OPTIONAL]
# ============================================================================

# Servidor SMTP [OPTIONAL]
# Para envío de confirmaciones por email
SMTP_HOST=smtp.yourprovider.com

# Puerto SMTP [OPTIONAL]
SMTP_PORT=587

# Usuario SMTP [OPTIONAL]
SMTP_USER=your_smtp_user

# Contraseña SMTP [OPTIONAL]
# Para Gmail usar App Password, no contraseña personal
# Para generar: openssl rand -base64 32
SMTP_PASS=YOUR_SECURE_SMTP_PASS_HERE

# Email de origen [OPTIONAL]
SMTP_FROM=reservas@your-domain.com

# Usar TLS para SMTP [OPTIONAL]
SMTP_USE_TLS=true

# ============================================================================
# 🎵 AUDIO & NLU CONFIGURATION
# ============================================================================

# Modelo de Whisper para transcripción [OPTIONAL]
# Valores: tiny, base, small, medium, large
# base = buen balance calidad/velocidad para MVP
AUDIO_MODEL=base

# Confianza mínima para transcripción [OPTIONAL]
# 0.0 a 1.0 - transcripciones con menor confianza piden texto manual
AUDIO_MIN_CONFIDENCE=0.6

# ============================================================================
# 🚦 RATE LIMITING
# ============================================================================

# Habilitar rate limiting [OPTIONAL]
RATE_LIMIT_ENABLED=true

# Número de requests permitidos por ventana [OPTIONAL]
RATE_LIMIT_REQUESTS=60

# Ventana de tiempo en segundos [OPTIONAL]
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# 📅 ICAL & BACKGROUND JOBS
# ============================================================================

# Intervalo de limpieza de pre-reservas expiradas (segundos) [OPTIONAL]
JOB_EXPIRATION_INTERVAL_SECONDS=60

# Intervalo de sincronización iCal (segundos) [OPTIONAL]
JOB_ICAL_INTERVAL_SECONDS=300

# Edad máxima de sync iCal antes de alertar (minutos) [OPTIONAL]
ICAL_SYNC_MAX_AGE_MINUTES=20

# ============================================================================
# 👨‍💼 ADMIN PANEL
# ============================================================================

# Emails permitidos para acceso admin [OPTIONAL]
# Lista separada por comas
ADMIN_ALLOWED_EMAILS=admin@example.com

# Secreto CSRF para admin panel [OPTIONAL]
# Si no se especifica, la app genera uno aleatorio al arrancar
# (ver backend/app/core/config.py -> secrets.token_urlsafe(24))
# NUNCA commitear un valor generado real en este archivo
ADMIN_CSRF_SECRET=

# ============================================================================
# 🔧 BACKUP & MONITORING (OPCIONAL para MVP)
# ============================================================================

# Directorio de backups [OPTIONAL]
BACKUP_DIR=./backups

# Días de retención de backups [OPTIONAL]
BACKUP_KEEP=7

# Webhook de Slack para alertas [OPTIONAL]
SLACK_WEBHOOK_URL=

# Grafana admin [OPTIONAL]
GRAFANA_ADMIN_USER=admin
# Contraseña Grafana (valor generado automáticamente):
GRAFANA_ADMIN_PASSWORD=DkKoJoAuFKmjvRyMcnkvXFZGzF4LqhrcXJe800oO/5g=

# ============================================================================
# 🚀 PRODUCTION CHECKLIST
# ============================================================================
#
# Antes de deploy en producción, asegúrate de:
#
# ✅ ENVIRONMENT=production
# ✅ DATABASE_URL apunta a PostgreSQL real con btree_gist
# ✅ REDIS_URL apunta a Redis real (no localhost)
# ✅ BASE_URL usa HTTPS (https://your-domain.com)
# ✅ WHATSAPP_* configurado con credenciales reales de Meta
# ✅ MERCADOPAGO_* configurado con credenciales de producción
# ✅ SMTP_* configurado para envío real de emails
# ✅ Todos los *_SECRET tienen valores únicos y seguros
# ✅ ALLOWED_ORIGINS incluye solo dominios de confianza
#
# 🔐 SECURITY NOTES:
# - Nunca usar valores "dummy" en producción
# - Rotar secrets regularmente
# - Usar HTTPS en producción (obligatorio)
# - Configurar firewall para DB y Redis
# - Monitorear logs para intentos de acceso no autorizado
#
